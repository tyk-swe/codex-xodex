[Unit]
Description=OpenAI Secure MCP Tunnel for chatgpt-xodex
After=xodex-mcp.service
Wants=xodex-mcp.service

[Service]
Type=simple
ExecStart=@TUNNEL_CLIENT@ run --profile-file @TUNNEL_CONFIG@
EnvironmentFile=@TUNNEL_ENV@
Environment=@MCP_ENV@
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
